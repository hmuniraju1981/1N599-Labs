# =============================================================================
# FILE: .env.example
# PURPOSE: Documents the environment variables the AI assistant needs.
#          Copy the values into the Cloudflare Pages dashboard, NOT into a
#          committed file.
#
#          Cloudflare dashboard → Workers & Pages → 1n599-inc → Settings →
#          Variables and secrets. Set them separately for Production and
#          Preview — a variable scoped to one environment does NOT exist in the
#          other.
#
# LOCAL DEV: `wrangler pages dev` reads local values from `.dev.vars` (which is
#          gitignored). Create it by copying this file:
#              cp .env.example .dev.vars
#          then paste your real key into .dev.vars only.
# =============================================================================

# Groq API key. Type: SECRET (encrypted) in the Cloudflare dashboard.
# Read ONLY by functions/api/assistant.ts, server-side. Never expose this to the
# browser and never prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=gsk_your_key_here

# Model ID. Type: plaintext variable.
# Must be a current *Production* model from https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
